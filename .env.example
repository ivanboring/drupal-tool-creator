# Model keys and agent endpoints for the tool creator harness (read by `tc` from the repo root).
# Every key is optional: set the ones for the backends you use. Claude Code, Codex and OpenCode
# also pick up your host logins: the ddev assistant add-ons copy ~/.claude, ~/.codex and the
# OpenCode config into the web container on every `ddev start`.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Small-model agents for the eval (`--agent fc:<endpoint>/<model>`). Any OpenAI-compatible
# chat-completions endpoint works. Endpoints are named TC_ENDPOINT_<NAME>_URL / _KEY; the
# <name> is what you write in the agent spec, lowercased.
#   --agent fc:ollama/qwen3-coder:30b
#   --agent fc:openrouter/qwen/qwen3-30b-a3b
# From the web container the host's Ollama is host.docker.internal (start Ollama with
# OLLAMA_HOST=0.0.0.0 so it listens beyond localhost).
TC_ENDPOINT_OLLAMA_URL=http://host.docker.internal:11434/v1
TC_ENDPOINT_OLLAMA_KEY=ollama
TC_ENDPOINT_OPENROUTER_URL=https://openrouter.ai/api/v1
TC_ENDPOINT_OPENROUTER_KEY=
TC_ENDPOINT_OPENAI_URL=https://api.openai.com/v1
TC_ENDPOINT_OPENAI_KEY=

# The agent that `tc eval` uses when --agent is not given.
TC_DEFAULT_AGENT=fc:ollama/qwen3-coder:30b
